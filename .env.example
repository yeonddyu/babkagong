# 서울관광재단 음식관광 데이터베이스 OPEN API (레드테이블) 토큰
# 발급: https://seoul.openapi.redtable.global
REDTABLE_API_KEY=

# 서울 열린데이터광장 인증키 (강남구 일반음식점 인허가 정보)
# 발급: https://data.seoul.go.kr
SEOUL_OPENAPI_KEY=

# 카카오 로컬 REST API 키
# 발급: https://developers.kakao.com
KAKAO_REST_API_KEY=

# 선택 설정
HTTP_TIMEOUT_SEC=10
CACHE_TTL_HOURS=168
# BABKAGONG_CACHE_DIR=data/cache
