# 밥카공 환경변수 예시 — 실제 값은 .env 에만 입력하고 커밋하지 않는다.

# 서울관광재단 음식관광 OPEN API (레드테이블) 토큰  (별칭: SEOUL_FOOD_API_TOKEN)
# 발급: https://seoul.openapi.redtable.global
REDTABLE_API_KEY=

# 서울 열린데이터광장 인증키  (별칭: SEOUL_OPEN_API_KEY)
# 발급: https://data.seoul.go.kr
SEOUL_OPENAPI_KEY=

# 카카오 로컬 REST API 키 (앱 설정에서 카카오맵 사용 설정 필요)
# 발급: https://developers.kakao.com
KAKAO_REST_API_KEY=

# 기상청 단기예보 조회서비스 (공공데이터포털 serviceKey, Encoding 값)
# 발급: https://www.data.go.kr/data/15084084/openapi.do
KMA_API_KEY=

# OpenAI (메인 Agent 의 요청 분석·응답 문장 생성)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SSAFY GMS — 현재는 키만 등록. 모델 연동은 범위 밖 (AI_PROVIDER=gms 로 두어도 OpenAI 사용)
GMS_API_KEY=
# AI_PROVIDER=openai

# 선택 설정
HTTP_TIMEOUT_SEC=10
CACHE_TTL_HOURS=168
MAX_REPLANS=3
# DATABASE_URL=sqlite:///backend/data/babkagong.db
# BABKAGONG_CACHE_DIR=backend/data/cache
