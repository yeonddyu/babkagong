# 밥카공 환경변수 예시 — 실제 값은 .env 에만 입력하고 커밋하지 않는다.

# 서울관광재단 음식관광 OPEN API (레드테이블) 토큰  (별칭: SEOUL_FOOD_API_TOKEN)
# 발급: https://seoul.openapi.redtable.global
REDTABLE_API_KEY=

# 서울 열린데이터광장 인증키  (별칭: SEOUL_OPEN_API_KEY)
# 발급: https://data.seoul.go.kr
SEOUL_OPENAPI_KEY=

# 카카오 로컬 REST API 키 (앱 설정에서 카카오맵 사용 설정 필요)
# 발급: https://developers.kakao.com
KAKAO_REST_API_KEY=

# 카카오 지도 JavaScript 키 (브라우저 공개용, 카카오 앱 Web 도메인에 http://localhost:5173 등록 필요)
VITE_KAKAO_MAP_KEY=

# 기상청 단기예보 조회서비스 (공공데이터포털 serviceKey, Encoding 값)
# 발급: https://www.data.go.kr/data/15084084/openapi.do
KMA_API_KEY=

# LLM — 기본 제공자 SSAFY GMS (OpenAI 호환 프록시, 요청 분석·응답 문장 생성)
AI_PROVIDER=gms
GMS_API_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# 모델 ID (비우거나 ID 형식이 아니면 gpt-4o-mini 사용). 확인된 모델: gpt-4o-mini, gpt-4.1-mini, gpt-4o
GMS_MODEL=gpt-4o-mini

# (선택) OpenAI 직접 호출 시 AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 선택 설정
HTTP_TIMEOUT_SEC=10
CACHE_TTL_HOURS=168
MAX_REPLANS=3
# DATABASE_URL=sqlite:///backend/data/babkagong.db
# BABKAGONG_CACHE_DIR=backend/data/cache
